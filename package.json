{
  "name": "biznes-hasap-pc",
  "version": "1.150.0",
  "type": "module",
  "description": "Biznes Hasap - Offline Mağaza ve Ön Muhasebe Yönetim Uygulaması",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"electron .\"",
    "electron:build": "vite build && electron-builder --publish never",
    "electron:build:signed": "vite build && electron-builder --win --config electron-builder.signing.cjs --publish never",
    "electron:dir": "vite build && electron-builder --win --dir --publish never",
    "electron:deploy": "vite build && electron-builder --win --dir --publish never && node scripts/deploy-installed.mjs",
    "release:check": "node license-native/scripts/release-check.js",
    "shortcuts": "powershell -ExecutionPolicy Bypass -File scripts/create-shortcuts.ps1",
    "cap:sync": "cap sync",
    "build:mobile": "vite build && cap sync",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "electron:release": "vite build && electron-builder --win --config electron-builder.signing.cjs --publish always",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^6.0.0",
    "@capacitor-mlkit/barcode-scanning": "^6.0.0",
    "@capacitor/android": "^6.1.4",
    "@capacitor/app": "^6.0.3",
    "@capacitor/browser": "^6.0.6",
    "@capacitor/camera": "^6.1.2",
    "@capacitor/core": "^6.1.4",
    "@capacitor/device": "^6.0.3",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/preferences": "^6.0.3",
    "@sentry/electron": "^8.1.0",
    "clsx": "^2.1.1",
    "crypto-pouch": "^4.0.2",
    "electron-updater": "6.8.9",
    "events": "^3.3.0",
    "exceljs": "^4.4.0",
    "js-yaml": "5.4.3",
    "lucide-react": "^0.475.0",
    "posthog-js": "^1.438.9",
    "pouchdb-browser": "^9.0.0",
    "pouchdb-find": "^9.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "tweetnacl": "^1.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.4",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.13.4",
    "@types/pouchdb-browser": "^6.1.5",
    "@types/pouchdb-find": "^7.3.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "happy-dom": "^20.14.5",
    "jsdom": "^30.1.2",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "com.bizneshasap.pos",
    "productName": "Biznes Hasap",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "license-native/native.js",
      "license-native/gate.js",
      "license-native/package.json",
      "license-native/build/Release/*.node",
      "!**/*.md",
      "!license-native/admin/**/*",
      "!license-native/admin-gui/**/*",
      "!license-native/test/**/*",
      "!license-native/third_party/**/*",
      "!license-native/src/**/*"
    ],
    "asarUnpack": [
      "license-native/build/Release/*.node"
    ],
    "win": {
      "signDlls": true,
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      },
      "target": [
        "nsis",
        "portable"
      ],
      "verifyUpdateCodeSignature": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraMetadata": {
      "desktopUpdatesEnabled": false
    },
    "publish": {
      "provider": "github",
      "owner": "pespaloglan-droid",
      "repo": "bizneshasapdev",
      "releaseType": "draft"
    }
  }
}
